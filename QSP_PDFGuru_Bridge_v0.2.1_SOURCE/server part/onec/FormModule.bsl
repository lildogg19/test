&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
НастройкиСервиса = QSPPDF_Обмен.Настройки(Ложь);
    АдресСервиса = НастройкиСервиса.Адрес;
    КлючСервиса = НастройкиСервиса.Ключ;
    ИдентификаторБазы = НастройкиСервиса.База;
    Если ПустаяСтрока(ИдентификаторБазы) Тогда ИдентификаторБазы = Строка(Новый УникальныйИдентификатор); КонецЕсли;
    Если ПустаяСтрока(АдресСервиса) Тогда АдресСервиса = "http://127.0.0.1:8020"; КонецЕсли;
    Статус = "Заполните настройки сервиса и выгрузите справочники. Пароль PDF Guru хранится в .env сервера.";
    Элементы.СоздатьКонтрагентаКнопка.Видимость = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ПодключитьОбработчикОжидания("ОбновитьПоТаймеру", 5);
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
    ОтключитьОбработчикОжидания("ОбновитьПоТаймеру");
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоТаймеру() Экспорт
    Попытка ОбновитьНаСервере(); Исключение Статус = "Ошибка соединения: " + ОписаниеОшибки(); КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
    ОбновитьПоТаймеру();
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()
    Если Не РольДоступна("ПолныеПрава") Тогда ВызватьИсключение "Настройки сервиса сохраняет администратор 1С."; КонецЕсли;
QSPPDF_Обмен.СохранитьНастройки(АдресСервиса, КлючСервиса, ИдентификаторБазы);
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)
    Попытка СохранитьНастройкиНаСервере(); Статус = "Настройки сохранены.";
    Исключение ПоказатьПредупреждение(, ОписаниеОшибки()); КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СинхронизироватьНаСервере()
    QSPPDF_Обмен.ВыгрузитьСправочники();
КонецПроцедуры

&НаКлиенте
Процедура Синхронизировать(Команда)
    Попытка СинхронизироватьНаСервере(); Статус = "Справочники выгружены; удалённые и помеченные объекты исключены.";
    Исключение ПоказатьПредупреждение(, ОписаниеОшибки()); КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьФайл(Команда)
    Оповещение = Новый ОписаниеОповещения("ПослеЗагрузки", ЭтотОбъект);
    Настройки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
    Настройки.ИдентификаторФормы = УникальныйИдентификатор;
    Настройки.Диалог.Заголовок = "Выберите счёт на оплату";
    Настройки.Диалог.Фильтр = "PDF и изображения|*.pdf;*.jpg;*.jpeg;*.png;*.tif;*.tiff;*.webp";
    ФайловаяСистемаКлиент.ЗагрузитьФайл(Оповещение, Настройки);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗагрузки(Файл, ДополнительныеПараметры) Экспорт
    Если Файл = Неопределено Тогда Возврат; КонецЕсли;
    Ключ = Строка(Новый УникальныйИдентификатор);
    Попытка
        ОтправитьНаСервере(Файл.Хранение, QSPPDF_ИмяФайлаБезПути(Файл.Имя), Ключ);
        Статус = "Файл добавлен в общую очередь. Можно продолжать работу.";
        ОбновитьПоТаймеру();
    Исключение ПоказатьПредупреждение(, ОписаниеОшибки()); КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция QSPPDF_ИмяФайлаБезПути(ПолноеИмя)
    Имя = Строка(ПолноеИмя);
    ПоследнийРазделитель = 0;
    Для Позиция = 1 По СтрДлина(Имя) Цикл
        Символ = Сред(Имя, Позиция, 1);
        Если Символ = "\" Или Символ = "/" Тогда
            ПоследнийРазделитель = Позиция;
        КонецЕсли;
    КонецЦикла;
    Возврат Сред(Имя, ПоследнийРазделитель + 1);
КонецФункции

&НаСервере
Процедура ОтправитьНаСервере(Адрес, Имя, Ключ)
    Результат = QSPPDF_Обмен.Загрузить(Адрес, Имя, Ключ);
    ТекущееЗадание = Результат.id;
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()
    Ответ = QSPPDF_Обмен.Очередь();
    Очередь.Очистить();
    Для Каждого Задание Из Ответ.jobs Цикл
        Строка = Очередь.Добавить(); Строка.Идентификатор = Задание.id;
        Строка.ИмяФайла = Задание.filename; Строка.Пользователь = Задание.actor;
        Строка.Состояние = Задание.stage; Строка.Позиция = Задание.position;
    КонецЦикла;
    Статус = Ответ.worker.message + "; ожидают: " + Строка(Ответ.global_waiting);
    Если Не ПустаяСтрока(ТекущееЗадание) Тогда
        Задание = QSPPDF_Обмен.Задание(ТекущееЗадание);
        Статус = Статус + ". Ваш файл: " + Задание.stage;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОчередьВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    Данные = Элементы.Очередь.ТекущиеДанные;
    Если Данные <> Неопределено Тогда ТекущееЗадание = Данные.Идентификатор; КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьРезультат(Команда)
    Попытка ПолучитьНаСервере(); Исключение ПоказатьПредупреждение(, ОписаниеОшибки()); КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ПолучитьНаСервере()
    Если ПустаяСтрока(ТекущееЗадание) Тогда ВызватьИсключение "Выберите задание или загрузите файл."; КонецЕсли;
    Ответ = QSPPDF_Обмен.Задание(ТекущееЗадание);
    Если Ответ.status <> "completed" И Ответ.status <> "imported" Тогда ВызватьИсключение "Распознавание ещё не завершено: " + Ответ.stage; КонецЕсли;
    ИсходныйJSON = QSPPDF_Обмен.СтрокаJSON(Ответ.invoice);
    СопоставлениеJSON = QSPPDF_Обмен.СтрокаJSON(Ответ.matches);
    ПоставщикНаименование = QSPPDF_СтроковоеПолеJSON(Ответ.invoice.supplier, "name");
    ПоставщикБИН = QSPPDF_СтроковоеПолеJSON(Ответ.invoice.supplier, "bin");
    ПоставщикАдрес = QSPPDF_СтроковоеПолеJSON(Ответ.invoice.supplier, "address");
    ПоставщикКБЕ = QSPPDF_СтроковоеПолеJSON(Ответ.invoice.supplier, "kbe");
    ПоставщикИИК = QSPPDF_СтроковоеПолеJSON(Ответ.invoice.supplier, "iban");
    ПоставщикБанк = QSPPDF_СтроковоеПолеJSON(Ответ.invoice.supplier, "bank_name");
    ПоставщикБИК = QSPPDF_СтроковоеПолеJSON(Ответ.invoice.supplier, "bic");
    НомерСчетаРаспознанный = QSPPDF_СтроковоеПолеJSON(Ответ.invoice, "number");
    ДатаСчетаРаспознанная = QSPPDF_СтроковоеПолеJSON(Ответ.invoice, "date");
    ИтогоСчетаРаспознанное = 0;
    Если Ответ.invoice.total <> Неопределено Тогда ИтогоСчетаРаспознанное = Ответ.invoice.total; КонецЕсли;
    Контрагент = Справочники.Контрагенты.ПустаяСсылка(); Организация = Справочники.Организации.ПустаяСсылка();
    Если Ответ.matches.supplier.id <> Неопределено Тогда Контрагент = QSPPDF_Обмен.СсылкаИзGUID("Контрагенты", Ответ.matches.supplier.id); КонецЕсли;
    Если Ответ.matches.organization.id <> Неопределено Тогда Организация = QSPPDF_Обмен.СсылкаИзGUID("Организации", Ответ.matches.organization.id); КонецЕсли;
    // Повторяем безопасный поиск непосредственно в 1С. Это заполняет стороны,
    // даже если справочники были выгружены уже после обработки файла.
    Если Не ЗначениеЗаполнено(Контрагент) И Ответ.invoice.supplier.bin <> Неопределено Тогда
        Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИдентификационныйКодЛичности", СокрЛП(Ответ.invoice.supplier.bin));
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Организация) И Ответ.invoice.buyer.bin <> Неопределено Тогда
        Организация = Справочники.Организации.НайтиПоРеквизиту("ИдентификационныйНомер", СокрЛП(Ответ.invoice.buyer.bin));
    КонецЕсли;
    ВалютаДокумента = Справочники.Валюты.ПустаяСсылка();
    Если Ответ.invoice.currency <> Неопределено Тогда
        ВалютаДокумента = Справочники.Валюты.НайтиПоРеквизиту("БуквенныйКод", ВРег(СокрЛП(Ответ.invoice.currency)));
    КонецЕсли;
    ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
    Если ЗначениеЗаполнено(Контрагент) И ЗначениеЗаполнено(Организация) Тогда
        ДоговорКонтрагента = QSPPDF_ЕдинственныйДоговор(Контрагент, Организация);
    КонецЕсли;
    Элементы.СоздатьКонтрагентаКнопка.Видимость = Не ЗначениеЗаполнено(Контрагент)
        И Не ПустаяСтрока(ПоставщикНаименование)
        И QSPPDF_КорректныйБИН(ПоставщикБИН);
    СуммаСтрокДокумента = 0;
    Для Каждого СтрокаДокумента Из Ответ.invoice.items Цикл
        Если СтрокаДокумента.amount <> Неопределено Тогда СуммаСтрокДокумента = СуммаСтрокДокумента + СтрокаДокумента.amount; КонецЕсли;
    КонецЦикла;
    НДСВключенВСумму = Ложь;
    Если Ответ.invoice.vat_mode = "with_vat" И Ответ.invoice.total <> Неопределено Тогда
        РазницаИтога = СуммаСтрокДокумента - Ответ.invoice.total;
        Если РазницаИтога < 0 Тогда РазницаИтога = -РазницаИтога; КонецЕсли;
        НДСВключенВСумму = РазницаИтога <= 0.05;
    КонецЕсли;
    Товары.Очистить(); Номер = 0;
    Для Каждого ИсходнаяСтрока Из Ответ.invoice.items Цикл
        С = Товары.Добавить(); С.Номер = Номер + 1; С.НаименованиеСкана = ИсходнаяСтрока.name;
        С.АртикулСкана = ?(ИсходнаяСтрока.sku = Неопределено, "", ИсходнаяСтрока.sku);
        С.ЕдиницаСкана = ИсходнаяСтрока.unit; С.Количество = ИсходнаяСтрока.quantity;
        С.Цена = ИсходнаяСтрока.price; С.Сумма = ИсходнаяСтрока.amount;
        С.Сопоставление = Ответ.matches.items[Номер].status;
        Если Ответ.matches.items[Номер].id <> Неопределено Тогда
            С.Номенклатура = QSPPDF_Обмен.СсылкаИзGUID("Номенклатура", Ответ.matches.items[Номер].id);
            С.ЕдиницаИзмерения = С.Номенклатура.БазоваяЕдиницаИзмерения;
        КонецЕсли;
        Если Ответ.invoice.vat_mode = "without_vat" Тогда
            С.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС", Истина);
        ИначеЕсли ИсходнаяСтрока.vat_rate <> Неопределено Тогда
            С.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоРеквизиту("Ставка", ИсходнаяСтрока.vat_rate);
        КонецЕсли;
        Номер = Номер + 1;
    КонецЦикла;
    Статус = "Проверьте исходный JSON, поставщика, организацию, договор и соответствие каждого товара.";
    Если Не ЗначениеЗаполнено(Контрагент) Тогда
        Если QSPPDF_КорректныйБИН(ПоставщикБИН) И Не ПустаяСтрока(ПоставщикНаименование) Тогда
            Статус = Статус + Символы.ПС + "Контрагент с БИН/ИИН " + ПоставщикБИН
                + " не найден. Доступна кнопка создания по распознанным реквизитам.";
        Иначе
            Статус = Статус + Символы.ПС + "Контрагент не найден; для безопасного создания нужны наименование и 12 цифр БИН/ИИН.";
        КонецЕсли;
    КонецЕсли;
    КоличествоНесопоставленных = 0;
    Для Каждого СтрокаТоваров Из Товары Цикл
        Если Не ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Тогда
            КоличествоНесопоставленных = КоличествоНесопоставленных + 1;
        КонецЕсли;
    КонецЦикла;
    Если КоличествоНесопоставленных > 0 Тогда
        Статус = Статус + Символы.ПС + "Не сопоставлено товарных строк: "
            + Строка(КоличествоНесопоставленных)
            + ". Выберите строку и нажмите «Создать номенклатуру из выбранной строки».";
    КонецЕсли;
    Попытка
        СостояниеСервиса = QSPPDF_Обмен.ЗапросСервиса("GET", "/health");
        ВерсияСервиса = "не определена";
        СостояниеСервиса.Свойство("version", ВерсияСервиса);
        Статус = Статус + Символы.ПС + "Версия сервера PDF Guru Bridge: " + ВерсияСервиса + ".";
    Исключение
    КонецПопытки;
    Если ПустаяСтрока(ПоставщикИИК) И ПустаяСтрока(ПоставщикБанк) И ПустаяСтрока(ПоставщикБИК) Тогда
        Статус = Статус + Символы.ПС
            + "Банковские реквизиты отсутствуют в результате. Для старого завершённого задания обновите сервер и выполните «Повторить»; затем снова получите результат.";
    КонецЕсли;
    Для Каждого Ошибка Из Ответ.invoice.validation_errors Цикл Статус = Статус + Символы.ПС + Ошибка; КонецЦикла;
    Для Каждого Сомнение Из Ответ.invoice.uncertainties Цикл Статус = Статус + Символы.ПС + Сомнение; КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуру(Команда)
    СтрокаТоваров = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТоваров = Неопределено Тогда
        ПоказатьПредупреждение(, "Выберите товарную строку.");
        Возврат;
    КонецЕсли;
    Если ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Тогда
        ПоказатьПредупреждение(, "Эта строка уже сопоставлена с номенклатурой.");
        Возврат;
    КонецЕсли;
    ТекстВопроса = "Найти точное совпадение ещё раз, а при его отсутствии создать товарную номенклатуру?"
        + Символы.ПС + СтрокаТоваров.НаименованиеСкана;
    Если Не ПустаяСтрока(СтрокаТоваров.АртикулСкана) Тогда
        ТекстВопроса = ТекстВопроса + Символы.ПС + "Артикул: " + СтрокаТоваров.АртикулСкана;
    КонецЕсли;
    ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПодтвержденияСозданияНоменклатуры", ЭтотОбъект, СтрокаТоваров.Номер),
        ТекстВопроса, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияСозданияНоменклатуры(Ответ, НомерСтроки) Экспорт
    Если Ответ <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
    Попытка
        РезультатСоздания = СоздатьНоменклатуруНаСервере(НомерСтроки);
        Статус = РезультатСоздания.Сообщение;
        ОткрытьЗначение(РезультатСоздания.Номенклатура);
    Исключение
        ПоказатьПредупреждение(, ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция СоздатьНоменклатуруНаСервере(НомерСтроки)
    СтрокаТоваров = Неопределено;
    Для Каждого ТекущаяСтрока Из Товары Цикл
        Если ТекущаяСтрока.Номер = НомерСтроки Тогда
            СтрокаТоваров = ТекущаяСтрока;
            Прервать;
        КонецЕсли;
    КонецЦикла;
    Если СтрокаТоваров = Неопределено Тогда ВызватьИсключение "Товарная строка не найдена. Получите результат повторно."; КонецЕсли;
    Если ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Тогда
        Возврат Новый Структура("Номенклатура,Сообщение", СтрокаТоваров.Номенклатура, "Строка уже сопоставлена.");
    КонецЕсли;
    Если ПустаяСтрока(СокрЛП(СтрокаТоваров.НаименованиеСкана)) Тогда
        ВызватьИсключение "Создание отменено: отсутствует наименование товара.";
    КонецЕсли;

    Единица = СтрокаТоваров.ЕдиницаИзмерения;
    Если Не ЗначениеЗаполнено(Единица) Тогда
        Единица = QSPPDF_НайтиЕдиницуИзмерения(СтрокаТоваров.ЕдиницаСкана);
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Единица) Тогда
        ВызватьИсключение "Единица измерения не найдена однозначно. Выберите её в колонке «ЕдиницаИзмерения» и повторите создание.";
    КонецЕсли;

    НачатьТранзакцию();
    Попытка
        // Повторный точный поиск внутри транзакции не позволяет создавать дубли
        // по артикулу или полному наименованию.
        НайденнаяНоменклатура = QSPPDF_НайтиТочнуюНоменклатуру(
            СтрокаТоваров.НаименованиеСкана, СтрокаТоваров.АртикулСкана);
        СозданНовыйЭлемент = Ложь;
        Если ЗначениеЗаполнено(НайденнаяНоменклатура) Тогда
            СсылкаНоменклатуры = НайденнаяНоменклатура;
        Иначе
            ОбъектНоменклатуры = Справочники.Номенклатура.СоздатьЭлемент();
            ОбъектНоменклатуры.Заполнить(Неопределено);
            ОбъектНоменклатуры.Наименование = Лев(СокрЛП(СтрокаТоваров.НаименованиеСкана), 100);
            ОбъектНоменклатуры.НаименованиеПолное = СокрЛП(СтрокаТоваров.НаименованиеСкана);
            ОбъектНоменклатуры.Артикул = Лев(СокрЛП(СтрокаТоваров.АртикулСкана), 25);
            ОбъектНоменклатуры.БазоваяЕдиницаИзмерения = Единица;
            ОбъектНоменклатуры.Услуга = Ложь;
            Если ЗначениеЗаполнено(СтрокаТоваров.СтавкаНДС) Тогда
                ОбъектНоменклатуры.СтавкаНДС = СтрокаТоваров.СтавкаНДС;
            КонецЕсли;
            ОбъектНоменклатуры.Записать();
            СсылкаНоменклатуры = ОбъектНоменклатуры.Ссылка;
            СозданНовыйЭлемент = Истина;
        КонецЕсли;
        СтрокаТоваров.Номенклатура = СсылкаНоменклатуры;
        СтрокаТоваров.ЕдиницаИзмерения = СсылкаНоменклатуры.БазоваяЕдиницаИзмерения;
        СтрокаТоваров.Сопоставление = ?(СозданНовыйЭлемент, "created", "matched_exact_in_1c");
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

    Попытка QSPPDF_Обмен.ВыгрузитьСправочники(); Исключение КонецПопытки;
    Если СозданНовыйЭлемент Тогда
        Сообщение = "Номенклатура создана и выбрана. Проверьте её карточку, особенно группу, счета учёта, единицу и ставку НДС.";
    Иначе
        Сообщение = "Найдено точное совпадение в 1С; существующая номенклатура выбрана без создания дубля.";
    КонецЕсли;
    Возврат Новый Структура("Номенклатура,Сообщение", СсылкаНоменклатуры, Сообщение);
КонецФункции

&НаСервереБезКонтекста
Функция QSPPDF_НайтиТочнуюНоменклатуру(Наименование, Артикул)
    Если Не ПустаяСтрока(СокрЛП(Артикул)) Тогда
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 2
        |   Номенклатура.Ссылка КАК Ссылка
        |ИЗ
        |   Справочник.Номенклатура КАК Номенклатура
        |ГДЕ
        |   Номенклатура.Артикул = &Артикул
        |   И НЕ Номенклатура.ЭтоГруппа
        |   И НЕ Номенклатура.ПометкаУдаления";
        Запрос.УстановитьПараметр("Артикул", СокрЛП(Артикул));
        Таблица = Запрос.Выполнить().Выгрузить();
        Если Таблица.Количество() = 1 Тогда Возврат Таблица[0].Ссылка; КонецЕсли;
        Если Таблица.Количество() > 1 Тогда ВызватьИсключение "Найдено несколько позиций с таким артикулом. Выберите номенклатуру вручную."; КонецЕсли;
    КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 2
    |   Номенклатура.Ссылка КАК Ссылка
    |ИЗ
    |   Справочник.Номенклатура КАК Номенклатура
    |ГДЕ
    |   Номенклатура.Наименование = &Наименование
    |   И НЕ Номенклатура.ЭтоГруппа
    |   И НЕ Номенклатура.ПометкаУдаления";
    Запрос.УстановитьПараметр("Наименование", Лев(СокрЛП(Наименование), 100));
    Таблица = Запрос.Выполнить().Выгрузить();
    Если Таблица.Количество() = 1 Тогда Возврат Таблица[0].Ссылка; КонецЕсли;
    Если Таблица.Количество() > 1 Тогда ВызватьИсключение "Найдено несколько позиций с таким наименованием. Выберите номенклатуру вручную."; КонецЕсли;
    Возврат Справочники.Номенклатура.ПустаяСсылка();
КонецФункции

&НаСервереБезКонтекста
Функция QSPPDF_НайтиЕдиницуИзмерения(ПредставлениеЕдиницы)
    Если ПустаяСтрока(СокрЛП(ПредставлениеЕдиницы)) Тогда
        Возврат Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
    КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 2
    |   Единицы.Ссылка КАК Ссылка
    |ИЗ
    |   Справочник.КлассификаторЕдиницИзмерения КАК Единицы
    |ГДЕ
    |   (Единицы.Наименование = &Представление
    |       ИЛИ Единицы.НаименованиеПолное = &Представление
    |       ИЛИ Единицы.Код = &Представление)
    |   И НЕ Единицы.ПометкаУдаления";
    Запрос.УстановитьПараметр("Представление", СокрЛП(ПредставлениеЕдиницы));
    Таблица = Запрос.Выполнить().Выгрузить();
    Если Таблица.Количество() = 1 Тогда Возврат Таблица[0].Ссылка; КонецЕсли;
    Возврат Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
КонецФункции

&НаСервереБезКонтекста
Функция QSPPDF_СтроковоеПолеJSON(СтруктураJSON, ИмяПоля)
    ЗначениеПоля = Неопределено;
    Если СтруктураJSON = Неопределено Тогда Возврат ""; КонецЕсли;
    Если Не СтруктураJSON.Свойство(ИмяПоля, ЗначениеПоля) Тогда Возврат ""; КонецЕсли;
    Если ЗначениеПоля = Неопределено Тогда Возврат ""; КонецЕсли;
    Возврат СокрЛП(Строка(ЗначениеПоля));
КонецФункции

&НаСервереБезКонтекста
Функция QSPPDF_КорректныйБИН(Знач БИН)
    БИН = СокрЛП(Строка(БИН));
    Если СтрДлина(БИН) <> 12 Тогда Возврат Ложь; КонецЕсли;
    Для Позиция = 1 По 12 Цикл
        Если Найти("0123456789", Сред(БИН, Позиция, 1)) = 0 Тогда Возврат Ложь; КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

&НаСервереБезКонтекста
Функция QSPPDF_ЕдинственныйДоговор(Контрагент, Организация)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 2
    |   Договоры.Ссылка КАК Ссылка
    |ИЗ
    |   Справочник.ДоговорыКонтрагентов КАК Договоры
    |ГДЕ
    |   Договоры.Владелец = &Контрагент
    |   И Договоры.Организация = &Организация
    |   И НЕ Договоры.ПометкаУдаления";
    Запрос.УстановитьПараметр("Контрагент", Контрагент);
    Запрос.УстановитьПараметр("Организация", Организация);
    Таблица = Запрос.Выполнить().Выгрузить();
    Если Таблица.Количество() = 1 Тогда Возврат Таблица[0].Ссылка; КонецЕсли;
    Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
КонецФункции

&НаКлиенте
Процедура СоздатьКонтрагента(Команда)
    ТекстВопроса = "Создать контрагента по распознанным данным?" + Символы.ПС
        + ПоставщикНаименование + Символы.ПС + "БИН/ИИН: " + ПоставщикБИН;
    Если Не ПустаяСтрока(ПоставщикИИК) Тогда
        ТекстВопроса = ТекстВопроса + Символы.ПС + "ИИК: " + ПоставщикИИК;
    КонецЕсли;
    ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПодтвержденияСозданияКонтрагента", ЭтотОбъект),
        ТекстВопроса, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияСозданияКонтрагента(Ответ, ДополнительныеПараметры) Экспорт
    Если Ответ <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
    Попытка
        РезультатСоздания = СоздатьКонтрагентаНаСервере();
        Контрагент = РезультатСоздания.Контрагент;
        Элементы.СоздатьКонтрагентаКнопка.Видимость = Ложь;
        Статус = РезультатСоздания.Сообщение;
        ОткрытьЗначение(Контрагент);
    Исключение
        ПоказатьПредупреждение(, ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция СоздатьКонтрагентаНаСервере()
    Если Не QSPPDF_КорректныйБИН(ПоставщикБИН) Тогда
        ВызватьИсключение "Создание отменено: БИН/ИИН должен содержать ровно 12 цифр.";
    КонецЕсли;
    Если ПустаяСтрока(СокрЛП(ПоставщикНаименование)) Тогда
        ВызватьИсключение "Создание отменено: на счёте не распознано наименование поставщика.";
    КонецЕсли;

    // Повторная проверка непосредственно перед записью защищает от дубля,
    // если другой пользователь успел создать того же контрагента.
    НайденныйКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту(
        "ИдентификационныйКодЛичности", СокрЛП(ПоставщикБИН));
    Если ЗначениеЗаполнено(НайденныйКонтрагент) Тогда
        Контрагент = НайденныйКонтрагент;
        Элементы.СоздатьКонтрагентаКнопка.Видимость = Ложь;
        Возврат Новый Структура("Контрагент,Сообщение", Контрагент,
            "Контрагент уже был создан другим пользователем и выбран по БИН/ИИН.");
    КонецЕсли;

    НачатьТранзакцию();
    Попытка
        ОбъектКонтрагента = Справочники.Контрагенты.СоздатьЭлемент();
        ОбъектКонтрагента.Наименование = Лев(СокрЛП(ПоставщикНаименование), 100);
        ОбъектКонтрагента.НаименованиеПолное = СокрЛП(ПоставщикНаименование);
        ОбъектКонтрагента.ИдентификационныйКодЛичности = СокрЛП(ПоставщикБИН);
        ОбъектКонтрагента.Комментарий = "Создан из распознанного счета № "
            + НомерСчетаРаспознанный + ". Реквизиты требуют проверки пользователем.";
        Если СтрДлина(СокрЛП(ПоставщикКБЕ)) = 2 Тогда
            ОбъектКонтрагента.КБЕ = СокрЛП(ПоставщикКБЕ);
        КонецЕсли;
        Если Лев(ВРег(СокрЛП(ПоставщикНаименование)), 3) = "ИП " Тогда
            ОбъектКонтрагента.ЮрФизЛицо = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо");
            ОбъектКонтрагента.ИндивидуальныйПредпринимательАдвокатЧастныйНотариус = Истина;
        Иначе
            ОбъектКонтрагента.ЮрФизЛицо = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо");
        КонецЕсли;
        ОбъектКонтрагента.Записать();

        Если Не ПустаяСтрока(СокрЛП(ПоставщикАдрес)) Тогда
            ЗаписьАдреса = РегистрыСведений["КонтактнаяИнформация"].СоздатьМенеджерЗаписи();
            ЗаписьАдреса.Объект = ОбъектКонтрагента.Ссылка;
            ЗаписьАдреса.Тип = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес");
            ЗаписьАдреса.Вид = ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ЮрАдресКонтрагента");
            ЗаписьАдреса.Представление = СокрЛП(ПоставщикАдрес);
            ЗаписьАдреса.Записать();
        КонецЕсли;

        ОсновнойБанковскийСчетЗаполнен = Ложь;
        ИИК = ВРег(СтрЗаменить(СокрЛП(ПоставщикИИК), " ", ""));
        БИК = ВРег(СтрЗаменить(СокрЛП(ПоставщикБИК), " ", ""));
        БанковскиеДанныеПолные = СтрДлина(ИИК) = 20 И Лев(ИИК, 2) = "KZ"
            И СтрДлина(БИК) = 8 И ЗначениеЗаполнено(ВалютаДокумента);
        Если БанковскиеДанныеПолные Тогда
            СсылкаБанк = QSPPDF_НайтиИлиСоздатьБанк(БИК, ПоставщикБанк);
            Если ЗначениеЗаполнено(СсылкаБанк) Тогда
                СсылкаСчета = QSPPDF_НайтиБанковскийСчет(ОбъектКонтрагента.Ссылка, ИИК);
                Если Не ЗначениеЗаполнено(СсылкаСчета) Тогда
                    ОбъектСчета = Справочники["БанковскиеСчета"].СоздатьЭлемент();
                    ОбъектСчета.Наименование = Лев(ИИК + " в " + Строка(СсылкаБанк), 50);
                    ОбъектСчета.Владелец = ОбъектКонтрагента.Ссылка;
                    ОбъектСчета.ВалютаДенежныхСредств = ВалютаДокумента;
                    ОбъектСчета.ВидСчета = "Расчетный";
                    ОбъектСчета.МесяцПрописью = Истина;
                    ОбъектСчета.НомерСчета = ИИК;
                    ОбъектСчета.Банк = СсылкаБанк;
                    ОбъектСчета.Записать();
                    СсылкаСчета = ОбъектСчета.Ссылка;
                КонецЕсли;
                ОбъектКонтрагента.ОсновнойБанковскийСчет = СсылкаСчета;
                ОбъектКонтрагента.Записать();
                ОсновнойБанковскийСчетЗаполнен = Истина;
            КонецЕсли;
        КонецЕсли;

        Контрагент = ОбъектКонтрагента.Ссылка;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

    ТекстРезультата = "Контрагент создан и выбран. Проверьте его карточку перед созданием счёта.";
    Если ОсновнойБанковскийСчетЗаполнен Тогда
        ТекстРезультата = ТекстРезультата + " Основной банковский счёт заполнен.";
    Иначе
        ТекстРезультата = ТекстРезультата
            + " Основной банковский счёт не создавался: нужны корректные ИИК, БИК и валюта; для нового банка также нужно его наименование.";
    КонецЕсли;
    Попытка QSPPDF_Обмен.ВыгрузитьСправочники(); Исключение КонецПопытки;
    Возврат Новый Структура("Контрагент,Сообщение", Контрагент, ТекстРезультата);
КонецФункции

&НаСервереБезКонтекста
Функция QSPPDF_НайтиИлиСоздатьБанк(БИК, НаименованиеБанка)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Банки.Ссылка КАК Ссылка
    |ИЗ
    |   Справочник.Банки КАК Банки
    |ГДЕ
    |   Банки.БИК = &БИК
    |   И НЕ Банки.ПометкаУдаления";
    Запрос.УстановитьПараметр("БИК", БИК);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда Возврат Выборка.Ссылка; КонецЕсли;
    Если ПустаяСтрока(СокрЛП(НаименованиеБанка)) Тогда Возврат Неопределено; КонецЕсли;
    ОбъектБанка = Справочники["Банки"].СоздатьЭлемент();
    ОбъектБанка.Наименование = Лев(СокрЛП(НаименованиеБанка), 100);
    ОбъектБанка.БИК = БИК;
    ОбъектБанка.Записать();
    Возврат ОбъектБанка.Ссылка;
КонецФункции

&НаСервереБезКонтекста
Функция QSPPDF_НайтиБанковскийСчет(Контрагент, ИИК)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Счета.Ссылка КАК Ссылка
    |ИЗ
    |   Справочник.БанковскиеСчета КАК Счета
    |ГДЕ
    |   Счета.Владелец = &Контрагент
    |   И Счета.НомерСчета = &ИИК
    |   И НЕ Счета.ПометкаУдаления";
    Запрос.УстановитьПараметр("Контрагент", Контрагент);
    Запрос.УстановитьПараметр("ИИК", ИИК);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда Возврат Выборка.Ссылка; КонецЕсли;
    Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
    Данные = Элементы.Товары.ТекущиеДанные;
    Если Данные <> Неопределено Тогда
        УстановитьБазовуюЕдиницуНаСервере(Данные.Номер);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьБазовуюЕдиницуНаСервере(Номер)
    Для Каждого С Из Товары Цикл
        Если С.Номер = Номер И ЗначениеЗаполнено(С.Номенклатура) Тогда
            С.ЕдиницаИзмерения = С.Номенклатура.БазоваяЕдиницаИзмерения;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПодтвердитьНаСервере()
    QSPPDF_Обмен.ПодтвердитьСопоставление(ТекущееЗадание, Контрагент, Организация, Товары);
КонецПроцедуры

&НаКлиенте
Процедура Подтвердить(Команда)
    Попытка ПодтвердитьНаСервере(); Статус = "Сопоставление сохранено для этого поставщика. Проверьте счёт перед созданием.";
    Исключение ПоказатьПредупреждение(, ОписаниеОшибки()); КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСчет(Команда)
    ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПодтвержденияСоздания", ЭтотОбъект),
        "Создать непроведённый счёт с выбранным сопоставлением и прикрепить исходный скан?", РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияСоздания(Ответ, ДополнительныеПараметры) Экспорт
    Если Ответ <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
    Попытка
        Ссылка = СоздатьНаСервере(); ОткрытьЗначение(Ссылка);
    Исключение ПоказатьПредупреждение(, ОписаниеОшибки()); КонецПопытки;
КонецПроцедуры

&НаСервере
Функция СоздатьНаСервере()
    Ссылка = QSPPDF_Обмен.СоздатьСчет(ТекущееЗадание, ДоговорКонтрагента, Склад, ВалютаДокумента, Товары, НДСВключенВСумму);
    Попытка
        Подтверждение = Новый Структура("base,document_id", QSPPDF_Обмен.Настройки().База, QSPPDF_Обмен.GUID(Ссылка));
        QSPPDF_Обмен.ЗапросСервиса("POST", "/jobs/" + ТекущееЗадание + "/imported", Подтверждение);
        Статус = "Непроведённый счёт создан, оригинал прикреплён.";
    Исключение
        Статус = "Счёт создан, но состояние очереди не обновлено. Повтор создания вернёт тот же документ.";
    КонецПопытки;
    Возврат Ссылка;
КонецФункции

&НаКлиенте
Процедура Повторить(Команда)
    Попытка ПовторитьНаСервере(); ОбновитьПоТаймеру();
    Исключение ПоказатьПредупреждение(, ОписаниеОшибки()); КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ПовторитьНаСервере()
    Если ПустаяСтрока(ТекущееЗадание) Тогда ВызватьИсключение "Выберите задание."; КонецЕсли;
    QSPPDF_Обмен.ЗапросСервиса("POST", "/jobs/" + ТекущееЗадание + "/retry" + QSPPDF_Обмен.ПараметрБазы());
КонецПроцедуры
