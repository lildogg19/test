Функция Настройки(ПроверятьЗаполнение = Истина) Экспорт
    Р = Новый Структура("Адрес,Ключ,База", "", "", "");
    ЗаписьНастроек = РегистрыСведений.QSPPDF_Настройки.СоздатьМенеджерЗаписи();
    ЗаписьНастроек.КлючНастройки = "Основные";
    ЗаписьНастроек.Прочитать();
    Р.Адрес = ЗаписьНастроек.АдресСервиса;
    Р.Ключ = ЗаписьНастроек.КлючСервиса;
    Р.База = ЗаписьНастроек.ИдентификаторБазы;
    Если ПроверятьЗаполнение И (ПустаяСтрока(Р.Адрес) Или ПустаяСтрока(Р.Ключ) Или ПустаяСтрока(Р.База)) Тогда
        ВызватьИсключение "Администратор должен заполнить настройки QSP PDF Guru.";
    КонецЕсли;
    Возврат Р;
КонецФункции

Процедура СохранитьНастройки(АдресСервиса, КлючСервиса, ИдентификаторБазы) Экспорт
    ЗаписьНастроек = РегистрыСведений.QSPPDF_Настройки.СоздатьМенеджерЗаписи();
    ЗаписьНастроек.КлючНастройки = "Основные";
    ЗаписьНастроек.АдресСервиса = АдресСервиса;
    ЗаписьНастроек.КлючСервиса = КлючСервиса;
    ЗаписьНастроек.ИдентификаторБазы = ИдентификаторБазы;
    ЗаписьНастроек.Записать();
КонецПроцедуры

Функция СтрокаJSON(Значение) Экспорт
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Возврат Запись.Закрыть();
КонецФункции

Функция ИзJSON(Текст) Экспорт
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Текст);
    Результат = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Результат;
КонецФункции

Функция ЗапросСервиса(Метод, Путь, Данные = Неопределено, ДвоичныйОтвет = Ложь) Экспорт
    Н = Настройки();
    Адрес = СокрЛП(Н.Адрес);
    SSL = Неопределено;
    Если Лев(Адрес, 8) = "https://" Тогда
        Адрес = Сред(Адрес, 9); Порт = 443; SSL = Новый ЗащищенноеСоединениеOpenSSL;
    ИначеЕсли Лев(Адрес, 7) = "http://" Тогда
        Адрес = Сред(Адрес, 8); Порт = 80;
    Иначе
        ВызватьИсключение "Адрес должен начинаться с http:// или https://.";
    КонецЕсли;
    Если СтрНайти(Адрес, "/") > 0 Тогда Адрес = Лев(Адрес, СтрНайти(Адрес, "/") - 1); КонецЕсли;
    Разделитель = СтрНайти(Адрес, ":");
    Если Разделитель > 0 Тогда
        Порт = Число(Сред(Адрес, Разделитель + 1)); Адрес = Лев(Адрес, Разделитель - 1);
    КонецЕсли;
    Соединение = Новый HTTPСоединение(Адрес, Порт, , , , 30, SSL);
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("X-QSP-Token", Н.Ключ);
    Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    ЗапросHTTP = Новый HTTPЗапрос(Путь, Заголовки);
    Если Данные <> Неопределено Тогда ЗапросHTTP.УстановитьТелоИзСтроки(СтрокаJSON(Данные), КодировкаТекста.UTF8); КонецЕсли;
    Ответ = Соединение.ВызватьHTTPМетод(Метод, ЗапросHTTP);
    Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
        // Не выводим тела ошибок и секреты в журнал 1С.
        ВызватьИсключение "QSP PDF Guru: HTTP " + Строка(Ответ.КодСостояния) + ". Проверьте очередь и настройки сервиса.";
    КонецЕсли;
    Если ДвоичныйОтвет Тогда Возврат Ответ.ПолучитьТелоКакДвоичныеДанные(); КонецЕсли;
    Возврат ИзJSON(Ответ.ПолучитьТелоКакСтроку());
КонецФункции

Функция ПараметрБазы() Экспорт
    Возврат "?base=" + КодироватьСтроку(Настройки().База, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Очередь() Экспорт
    Возврат ЗапросСервиса("GET", "/queue" + ПараметрБазы());
КонецФункции

Функция Задание(Идентификатор) Экспорт
    Возврат ЗапросСервиса("GET", "/jobs/" + Идентификатор + ПараметрБазы());
КонецФункции

Функция GUID(Ссылка) Экспорт
    Если Не ЗначениеЗаполнено(Ссылка) Тогда Возврат ""; КонецЕсли;
    Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция СсылкаИзGUID(ИмяСправочника, Идентификатор) Экспорт
    Если ПустаяСтрока(Идентификатор) Тогда Возврат Справочники[ИмяСправочника].ПустаяСсылка(); КонецЕсли;
    Ссылка = Справочники[ИмяСправочника].ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
    Объект = Ссылка.ПолучитьОбъект();
    Если Объект = Неопределено Или Объект.ПометкаУдаления Тогда
        ВызватьИсключение "Объект справочника отсутствует или помечен на удаление. Обновите сопоставление.";
    КонецЕсли;
    Возврат Ссылка;
КонецФункции

Процедура ВыгрузитьСправочники() Экспорт
    Пакет = Новый Структура("base,suppliers,organizations,items", Настройки().База, Новый Массив, Новый Массив, Новый Массив);
    Выборка = Справочники.Контрагенты.Выбрать();
    Пока Выборка.Следующий() Цикл
        Если Выборка.ПометкаУдаления Или Выборка.ЭтоГруппа Тогда Продолжить; КонецЕсли;
        Пакет.suppliers.Добавить(Новый Структура("id,name,bin", GUID(Выборка.Ссылка), Выборка.Наименование, СокрЛП(Выборка.ИдентификационныйКодЛичности)));
    КонецЦикла;
    Выборка = Справочники.Организации.Выбрать();
    Пока Выборка.Следующий() Цикл
        Если Выборка.ПометкаУдаления Тогда Продолжить; КонецЕсли;
        Пакет.organizations.Добавить(Новый Структура("id,name,bin", GUID(Выборка.Ссылка), Выборка.Наименование, СокрЛП(Выборка.ИдентификационныйНомер)));
    КонецЦикла;
    Выборка = Справочники.Номенклатура.Выбрать();
    Пока Выборка.Следующий() Цикл
        Если Выборка.ПометкаУдаления Или Выборка.ЭтоГруппа Тогда Продолжить; КонецЕсли;
        Пакет.items.Добавить(Новый Структура("id,name,sku,unit,unit_id,service", GUID(Выборка.Ссылка), Выборка.Наименование,
            Выборка.Артикул, Строка(Выборка.БазоваяЕдиницаИзмерения), GUID(Выборка.БазоваяЕдиницаИзмерения), Выборка.Услуга));
    КонецЦикла;
    ЗапросСервиса("POST", "/references", Пакет);
КонецПроцедуры

Функция Загрузить(АдресХранения, ИмяФайла, КлючЗапроса) Экспорт
    Двоичные = ПолучитьИзВременногоХранилища(АдресХранения);
    Если Двоичные = Неопределено Тогда ВызватьИсключение "Файл не найден во временном хранилище."; КонецЕсли;
    ТекстФайла = СтрЗаменить(СтрЗаменить(Base64Строка(Двоичные), Символы.ПС, ""), Символы.ВК, "");
    Данные = Новый Структура("base,actor,request_key,filename,content_base64", Настройки().База,
        ПользователиИнформационнойБазы.ТекущийПользователь().Имя, КлючЗапроса, ИмяФайла, ТекстФайла);
    Возврат ЗапросСервиса("POST", "/jobs", Данные);
КонецФункции

Процедура ПодтвердитьСопоставление(Идентификатор, Контрагент, Организация, Товары) Экспорт
    Если Не ЗначениеЗаполнено(Контрагент) Или Не ЗначениеЗаполнено(Организация) Тогда ВызватьИсключение "Выберите поставщика и организацию."; КонецЕсли;
    Идентификаторы = Новый Массив;
    Для Каждого Товар Из Товары Цикл
        Если Не ЗначениеЗаполнено(Товар.Номенклатура) Тогда ВызватьИсключение "Сопоставьте все товарные строки."; КонецЕсли;
        Идентификаторы.Добавить(GUID(Товар.Номенклатура));
    КонецЦикла;
    Данные = Новый Структура("base,supplier_id,organization_id,item_ids", Настройки().База, GUID(Контрагент), GUID(Организация), Идентификаторы);
    ЗапросСервиса("POST", "/jobs/" + Идентификатор + "/confirm-matches", Данные);
КонецПроцедуры

Функция СоздатьСчет(Идентификатор, Договор, Склад, Валюта, Товары, НДСВключенВСумму) Экспорт
    Если ПустаяСтрока(СокрЛП(Идентификатор)) Тогда
        ВызватьИсключение "Не выбрано задание распознавания.";
    КонецЕсли;
    Результат = ЗапросСервиса("GET", "/jobs/" + Идентификатор + "/confirmed" + ПараметрБазы());
    Данные = Результат.invoice;
    Если Данные.validation_errors.Количество() > 0 Тогда ВызватьИсключение "Есть ошибки распознавания. Создание счёта заблокировано."; КонецЕсли;
    Поставщик = СсылкаИзGUID("Контрагенты", Результат.matches.supplier_id);
    Организация = СсылкаИзGUID("Организации", Результат.matches.organization_id);
    // Несоответствие договора показывается пользователю до создания документа,
    // но не блокирует запись: бухгалтер сможет исправить договор в открытой карточке.
    // Штатные проверки конфигурации по-прежнему могут потребовать заполненный договор.
    Если Не ЗначениеЗаполнено(Валюта) Или Валюта.ПометкаУдаления Или Валюта.БуквенныйКод <> Данные.currency Тогда
        ВызватьИсключение "Проверьте валюту счёта: она должна совпадать с распознанной валютой документа.";
    КонецЕсли;
    // Для иностранной валюты нельзя произвольно подставлять курс 1.
    Если Данные.currency <> "KZT" Тогда ВызватьИсключение "В этой версии импорт поддерживает только KZT; валютный счёт заполните вручную."; КонецЕсли;
    Если Товары.Количество() <> Данные.items.Количество() Тогда ВызватьИсключение "Число строк изменилось; обновите результат."; КонецЕсли;
    СуммаСтрок = 0; СуммаНДС = 0;
    Для НомерСтроки = 0 По Товары.Количество() - 1 Цикл
        Товар = Товары[НомерСтроки]; ИсходнаяСтрока = Данные.items[НомерСтроки];
        Если GUID(Товар.Номенклатура) <> Результат.matches.item_ids[НомерСтроки] Тогда ВызватьИсключение "Повторно подтвердите изменённое сопоставление."; КонецЕсли;
        Если Товар.Номенклатура.ПометкаУдаления Или Не ЗначениеЗаполнено(Товар.СтавкаНДС) Или Товар.СтавкаНДС.ПометкаУдаления Тогда
            ВызватьИсключение "Выберите действующую номенклатуру и ставку НДС каждой строки.";
        КонецЕсли;
        Если Данные.vat_mode = "without_vat" Тогда
            Если НРег(СтрЗаменить(Строка(Товар.СтавкаНДС), " ", "")) <> "безндс" Тогда
                ВызватьИсключение "Для счёта Без НДС выберите именно Без НДС, а не ставку 0%.";
            КонецЕсли;
        ИначеЕсли ИсходнаяСтрока.vat_rate = Неопределено Или ИсходнаяСтрока.vat_amount = Неопределено Тогда
            ВызватьИсключение "Не распознана ставка или сумма НДС; импорт заблокирован.";
        ИначеЕсли Товар.СтавкаНДС.Ставка <> ИсходнаяСтрока.vat_rate Тогда
            ВызватьИсключение "Выбранная ставка НДС отличается от распознанной.";
        КонецЕсли;
        СуммаСтрок = СуммаСтрок + ИсходнаяСтрока.amount;
        Если ИсходнаяСтрока.vat_amount <> Неопределено Тогда СуммаНДС = СуммаНДС + ИсходнаяСтрока.vat_amount; КонецЕсли;
        Если Не Товар.Номенклатура.Услуга И Товар.ЕдиницаИзмерения <> Товар.Номенклатура.БазоваяЕдиницаИзмерения Тогда
            ВызватьИсключение "Единица отличается от базовой. Требуется проверка коэффициента; автоматическая конвертация запрещена.";
        КонецЕсли;
        Если НРег(СокрЛП(Строка(Товар.ЕдиницаИзмерения))) <> НРег(СокрЛП(ИсходнаяСтрока.unit)) Тогда
            ВызватьИсключение "Единица измерения отличается от напечатанной. Проверьте исходник.";
        КонецЕсли;
    КонецЦикла;
    ОжидаемыйИтог = СуммаСтрок;
    Если Данные.vat_mode = "with_vat" И Не НДСВключенВСумму Тогда ОжидаемыйИтог = ОжидаемыйИтог + СуммаНДС; КонецЕсли;
    РазницаИтога = ОжидаемыйИтог - Данные.total;
    Если РазницаИтога < 0 Тогда РазницаИтога = -РазницаИтога; КонецЕсли;
    Если РазницаИтога > 0.05 Тогда ВызватьИсключение "Проверьте флаг НДС включён в сумму: строки и НДС не совпадают с итогом счёта."; КонецЕсли;
    Исходник = ЗапросСервиса("GET", "/jobs/" + Идентификатор + "/source" + ПараметрБазы(), , Истина);
    ЗаданиеСервиса = Задание(Идентификатор);
    ДатаДокумента = Дата(Число(Лев(Данные.date,4)), Число(Сред(Данные.date,6,2)), Число(Сред(Данные.date,9,2)));
    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        Элемент = Блокировка.Добавить("РегистрСведений.QSPPDF_ИмпортированныеЗадания");
        Элемент.УстановитьЗначение("Задание", Идентификатор);
        Блокировка.Заблокировать();
        Запись = РегистрыСведений.QSPPDF_ИмпортированныеЗадания.СоздатьМенеджерЗаписи();
        Запись.Задание = Идентификатор;
        Запись.Прочитать();
        Если ЗначениеЗаполнено(Запись.Документ) Тогда
            Ссылка = Запись.Документ; ЗафиксироватьТранзакцию(); Возврат Ссылка;
        КонецЕсли;
        // Если записи ещё нет, Прочитать() очищает измерения менеджера записи.
        // Восстанавливаем ключ перед последующей записью результата импорта.
        Запись.Задание = Идентификатор;
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 С.Ссылка ИЗ Документ.СчетНаОплатуПоставщика КАК С ГДЕ НЕ С.ПометкаУдаления И С.Контрагент = &П И С.Организация = &О И С.НомерВходящегоДокумента = &Н И С.ДатаВходящегоДокумента = &Д");
        Запрос.УстановитьПараметр("П", Поставщик); Запрос.УстановитьПараметр("О", Организация);
        Запрос.УстановитьПараметр("Н", Данные.number); Запрос.УстановитьПараметр("Д", ДатаДокумента);
        Если Не Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "Счёт с такими реквизитами уже существует. Проверьте документ, повторный не создан."; КонецЕсли;
        Док = Документы.СчетНаОплатуПоставщика.СоздатьДокумент();
        Док.Дата = ДатаДокумента; Док.ДатаВходящегоДокумента = ДатаДокумента;
        Док.НомерВходящегоДокумента = Данные.number;
        Док.Организация = Организация; Док.Контрагент = Поставщик; Док.ДоговорКонтрагента = Договор;
        Док.ВалютаДокумента = Валюта; Док.КурсВзаиморасчетов = 1; Док.КратностьВзаиморасчетов = 1;
        Док.Склад = Склад; Док.УчитыватьНДС = Данные.vat_mode = "with_vat";
        Док.СуммаВключаетНДС = Док.УчитыватьНДС И НДСВключенВСумму;
        Док.Комментарий = "[QSP-PDFGURU:" + Идентификатор + "]";
        Для НомерСтроки = 0 По Товары.Количество() - 1 Цикл
            Товар = Товары[НомерСтроки]; ИсходнаяСтрока = Данные.items[НомерСтроки];
            Если Товар.Номенклатура.Услуга Тогда
                СтрокаДок = Док.Услуги.Добавить(); СтрокаДок.Содержание = ИсходнаяСтрока.name;
            Иначе
                СтрокаДок = Док.Товары.Добавить(); СтрокаДок.ЕдиницаИзмерения = Товар.ЕдиницаИзмерения; СтрокаДок.Коэффициент = 1;
            КонецЕсли;
            СтрокаДок.Номенклатура = Товар.Номенклатура; СтрокаДок.Количество = ИсходнаяСтрока.quantity;
            СтрокаДок.Цена = ИсходнаяСтрока.price; СтрокаДок.Сумма = ИсходнаяСтрока.amount;
            СтрокаДок.СтавкаНДС = Товар.СтавкаНДС;
            СтрокаДок.СуммаНДС = ?(Данные.vat_mode = "without_vat", 0, ИсходнаяСтрока.vat_amount);
        КонецЦикла;
        Док.СуммаДокумента = Данные.total;
        Док.Записать(РежимЗаписиДокумента.Запись);
        ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
        ПараметрыФайла.ВладелецФайлов = Док.Ссылка;
        ПараметрыФайла.ИмяБезРасширения = ЗаданиеСервиса.filename;
        АдресФайла = ПоместитьВоВременноеХранилище(Исходник);
        РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресФайла);
        Запись.Документ = Док.Ссылка; Запись.Записать();
        Ссылка = Док.Ссылка; ЗафиксироватьТранзакцию(); Возврат Ссылка;
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецФункции
